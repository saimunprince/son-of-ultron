# secrets
backend/config/config.toml
backend/config/brains.json
backend/config/brains.tmp
backend/config/mcp.json
backend/config/ws.token
.env
.env.*

# python
backend/.venv/
__pycache__/
*.pyc

# node / next
frontend/node_modules/
frontend/.next/
frontend/next-env.d.ts

# runtime
backend/workspace/*
!backend/workspace/example.txt
backend/logs/
*.log
backend/.syrax-browser/
backend/config/memory.json
backend/config/history.jsonl
backend/config/*.tmp
# memory exports (memory_export / python -m syrax.memory --export): the human's facts, never committed
backend/config/exports/

# SYRAX's per-task worktrees (M1, isolated evolution)
.syrax/

# durable execution journal (runtime state)
backend/config/journal.db
backend/config/journal.db-wal
backend/config/journal.db-shm
backend/config/journal.db.owner
# the launcher's known-good / known-bad commits (syrax.py, known-good fallback)
backend/config/known_good.json
backend/config/rollback/
# verified snapshots of the journal and config (they hold the API keys)
backend/config/backups/
syrax.pid
syrax.log
# skills SYRAX builds are verified by the skill factory (their own pytest), live outside git,
# and must never be removed by the post-task rollback of uncommitted work
backend/skills/*
!backend/skills/README.md
